PIPELINE_BACKEND=cpu
PIPELINE_VERSION=v1
INPUT_SOURCE=http://192.168.100.4:8080/api/videos/test1.mp4/stream
CAMERA_ID=test1
TARGET_FPS=2
RETRY_INTERVAL=5
MOTION_THRESHOLD=0.5
FRAME_STORE_DIR=./data/frame_store
FRAME_TTL_SEC=300
REDIS_HOST=localhost
REDIS_PORT=6379
ENABLE_STREAM_PUBLISH=true
ENABLE_HEALTH_PUBLISH=true
PREPROCESS_STREAM=camera:preprocess_stream
DETECTIONS_STREAM=camera:detections_stream
TRACKS_STREAM=camera:tracks_stream
HEALTH_STREAM=camera:health_stream
STREAM_MAXLEN=1000
HEALTH_PUBLISH_INTERVAL_SEC=10
LOG_LEVEL=INFO
GPU_ID=0
GPU_DECODER_BUFFER_SIZE=12
SOURCE_KIND=auto
METADATA_KEY_PREFIX=camera:metadata
